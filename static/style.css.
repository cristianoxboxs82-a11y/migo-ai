:root{color-scheme:dark;--bg:#0c0816;--panel:#171126;--line:#302445;--purple:#a78bfa;--pink:#f0abfc;--text:#f7f2ff;--muted:#b6abc9}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#281542 0,#0c0816 48%);font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:var(--text);min-height:100vh}
.wrap{width:min(760px,100%);margin:auto;padding:22px 16px 40px}.hero{display:flex;gap:16px;align-items:center;margin:10px 0 22px}.orb{width:76px;height:76px;flex:none;display:grid;place-items:center;font-size:38px;border-radius:24px;background:linear-gradient(135deg,#6d28d9,#db2777);box-shadow:0 0 40px #a855f755}.eyebrow{font-size:11px;letter-spacing:2px;color:var(--pink);font-weight:800;margin:0 0 3px}h1{font-size:38px;line-height:1;margin:0;letter-spacing:1px}h1 span{color:var(--purple)}.sub{color:var(--muted);margin:8px 0 0;font-size:14px}.panel{background:#171126eF;border:1px solid var(--line);border-radius:20px;padding:18px;margin-bottom:14px;box-shadow:0 10px 35px #0003}label{font-size:13px;font-weight:700;color:#e8ddff}.connect-row{display:flex;gap:9px;margin-top:9px}input:not([type=checkbox]){min-width:0;flex:1;background:#0e0a19;border:1px solid #47365f;border-radius:12px;padding:13px;color:white;font-size:16px}button{border:0;border-radius:12px;padding:0 18px;background:linear-gradient(120deg,#8b5cf6,#d946ef);font-weight:800;color:white;font-size:14px}button:disabled{opacity:.5}.status-line{display:flex;align-items:center;gap:8px;margin-top:13px;font-size:13px;color:var(--muted)}.dot{width:9px;height:9px;border-radius:50%;background:#777}.dot.on{background:#4ade80;box-shadow:0 0 12px #4ade80}.error{color:#fda4af;font-size:12px;margin:5px 0}.hint,.disclaimer{color:#a89bbd;font-size:11px;line-height:1.5}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}.stat{background:#171126;border:1px solid var(--line);border-radius:17px;padding:14px 10px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px}.stat span{font-size:20px}.stat strong{font-size:24px}.stat small{font-size:11px;color:var(--muted)}.feed-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.feed-head h2{font-size:17px;margin:0}.toggle{display:flex;align-items:center;gap:6px;font-size:11px!important;color:var(--muted)}.feed{display:flex;flex-direction:column;gap:9px;margin-top:14px;max-height:50vh;overflow:auto}.item{padding:11px 12px;border-radius:13px;background:#0f0b1b;border:1px solid #2d2140}.item.ai{border-color:#7650a6;background:#241634}.item.gift{border-color:#8a4a78}.meta{display:flex;justify-content:space-between;gap:10px;font-size:11px;color:#c4b5fd;margin-bottom:4px}.message{font-size:14px;line-height:1.4;overflow-wrap:anywhere}.extra{font-size:11px;color:#b7a7cc;margin-top:4px}.empty{text-align:center;color:#a89bbd;font-size:13px;padding:26px 8px}.disclaimer{margin:18px 4px 0}@media(max-width:420px){.wrap{padding:16px 12px}.orb{width:60px;height:60px;border-radius:18px;font-size:30px}h1{font-size:32px}.connect-row{flex-direction:column}button{padding:13px}.stats{gap:7px}.stat{padding:12px 5px}.stat strong{font-size:21px}}
